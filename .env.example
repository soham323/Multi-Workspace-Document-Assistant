# ─── Supabase ──────────────────────────────────────────────────────────────────
# Browser-safe: used for Supabase Auth in client components (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: bypasses RLS — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Server-only: used for LLM chat (gemini-2.0-flash) + embeddings (text-embedding-004)
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Discord ───────────────────────────────────────────────────────────────────
# Server-only: used by the send_channel_notification tool
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# ─── RAG Configuration (optional — these are the defaults) ────────────────────
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_MATCH_THRESHOLD=0.40
MAX_UPLOAD_SIZE_MB=10
CHAT_HISTORY_TURNS=10
